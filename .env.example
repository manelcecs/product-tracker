# Telegram notifications.
# Monitoring runs without these set, but no alerts will be sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Global scheduling window, in seconds. Each retailer picks a random delay
# inside [MIN, MAX] before its next check (jitter), so retailers never fire
# at the exact same time.
CHECK_INTERVAL_MIN_SECONDS=60
CHECK_INTERVAL_MAX_SECONDS=80

# Minimum relative price change (percent) while AVAILABLE/PREORDER that
# triggers a price-change notification.
SIGNIFICANT_PRICE_CHANGE_PERCENT=5

# Persistence
DATA_DIR=./data

# Logging: "info" | "debug" | "warn" | "error". Set LOG_PRETTY=true for
# human-readable console output during local development.
LOG_LEVEL=info
LOG_PRETTY=false

# ---- Product identity (configurable; defaults target the Zelda 40th
# Anniversary Switch 2 bundle) ----
PRODUCT_NAME="Nintendo Switch 2 - The Legend of Zelda 40th Anniversary Edition"
PRODUCT_EAN=0045496337292
PRODUCT_MPN=10019448
PRODUCT_RELEASE_DATE=2026-10-29
# Comma-separated, case-insensitive substrings that must ALL appear in a
# product's title/identity text for a match (used when EAN/MPN aren't
# present in the page's structured data).
PRODUCT_REQUIRED_KEYWORDS="nintendo switch 2,zelda,40"
# Comma-separated substrings that disqualify a match (accessories, etc).
PRODUCT_EXCLUDED_KEYWORDS="funda,carcasa,mando,case,grip,protector,cable,soporte,figura,amiibo,dock"

# ---- Retailers ----

MEDIAMARKT_ES_ENABLED=true
MEDIAMARKT_ES_URL=https://www.mediamarkt.es/es/product/_consola-nintendo-switch-2-edicion-zelda-40-aniversario-79-full-hd-hdr-120-hz-256-gb-magnetic-joy-con-2-con-modo-raton-bateria-extraible-1674231.html
# Optional per-retailer interval override. Leave blank to use global values.
# MEDIAMARKT_ES_CHECK_INTERVAL_MIN_SECONDS=60
# MEDIAMARKT_ES_CHECK_INTERVAL_MAX_SECONDS=80

# Amazon ES — verified ASIN for the Zelda 40th Anniversary bundle
# (live-checked 2026-09-24, matched via "Número de modelo del producto"
# 10019448). See README "Verified retailer coverage" section.
AMAZON_ES_ASIN=B0F2TN43GH
AMAZON_ES_ENABLED=true
# AMAZON_ES_CHECK_INTERVAL_MIN_SECONDS=120
# AMAZON_ES_CHECK_INTERVAL_MAX_SECONDS=180

# GAME ES — verified product page (live-checked 2026-09-24), JSON-LD Product.
GAME_ES_ENABLED=true
GAME_ES_URL=https://www.game.es/nintendo-switch-2-edicion-zelda-40th-nintendo-switch-2-267689
# GAME_ES_CHECK_INTERVAL_MIN_SECONDS=60
# GAME_ES_CHECK_INTERVAL_MAX_SECONDS=80

# Fnac ES and El Corte Inglés ES are intentionally NOT supported: both sit
# behind Akamai Bot Manager, which rejects every automated client (HTTP 403,
# including real headless Chrome) while serving normal browsers. Getting past
# it would require anti-bot evasion, which this project does not do
# (see AGENTS.md). Removed 2026-09-24.
